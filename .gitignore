file1.py
# Step 0: Pre-requisites
git --version
git config --global user.name "Vaishnavi Gupta"
git config --global user.email "vaishnavi@example.com"
git config --list

# Step 1: Create project
mkdir my-first-project
cd my-first-project

# Step 2: Initialize Git repo
git init
ls -a

# Step 3: Add files + .gitignore
echo "print('Hello World')" > file1.py
echo ".env" > .gitignore
echo "node_modules/" >> .gitignore
echo "*.log" >> .gitignore

# Step 4: Stage files
git add .
git status

# Step 5: Commit
git commit -m "Initial commit"

# Step 6: Create remote on GitHub (UI step)

# Step 7: Connect local → remote
git remote add origin https://github.com/yourusername/my-first-project.git
git remote -v

# Step 8: Push local → remote
git push -u origin main

# Step 10: Optional clone
cd ..
git clone https://github.com/yourusername/my-first-project.git
cd my-first-project
